{
  "kit": {
    "name": "Nebari Design System",
    "fileKey": "<file key>",
    "url": "https://www.figma.com/design/<file key>/Nebari-Design-System"
  },
  "base": { "shadcn": "base-vega" },
  "theme": "src/kit.css",
  "css": "src/index.css",
  "components": "src/components/ui",
  "alias": "@/components/ui",
  "cn": "@/lib/utils",
  "icons": { "package": "lucide-react", "suffix": "", "case": "kebab" },
  "behavior": ["@base-ui/react", "@tanstack/react-table", "react-day-picker"],
  "darkSelector": ".dark",
  "adapter": {
    "skipPages": ["Cover", "Typography", "Colors", "Logo", "New Component Template", "Nat Playground"],
    "iconPage": "Icons",
    "names": { "derive": true, "ignoreSyntax": ["Brand Colors", "Semantic"] },
    "stateAxes": ["interaction states"],
    "files": {
      "Buttons": "button",
      "Datatable": "data-table",
      "KBP": "kbd",
      "Navigation Menu / Bar": "navigation-menu",
      "Radio": "radio-group",
      "Sidebar Nav": "sidebar",
      "Tooltips": "tooltip",
      "Utilities": "popover"
    },
    "shadcn": {
      "Datatable": "table"
    },
    "behavior": {
      "Accordion Item": "@base-ui/react/accordion",
      "Alert": "none (a div with role=\"alert\")",
      "Avatar": "@base-ui/react/avatar",
      "Avatar Group": "none (a div; composes Avatar)",
      "Avatar / Form Field": "none (a div; composes Avatar, Button)",
      "Avatar / Avatar Badge": "none (a span)",
      "Badge / Static": "none (a span)",
      "[Deprecated] Badge / Interactive": "none (a button)",
      "Breadcrumb": "none (a nav holding an ol)",
      "Breadcrumb / BreadcrumbItem": "none (an li holding an anchor; Type=Dropdown composes Dropdown Menu)",
      "Breadcrumb / Separator": "none (an li with aria-hidden)",
      "Button": "@base-ui/react/button",
      "Button Group": "none (a div with role=\"group\"; composes Button)",
      "Calendar": "react-day-picker",
      "Calendar / Day": "react-day-picker",
      "Card": "none (a div)",
      "Checkbox": "@base-ui/react/checkbox",
      "Chip*": "none (a button)",
      "Code Block": "none (a pre holding a code)",
      "Combobox / *": "@base-ui/react/combobox",
      "Datatable": "@tanstack/react-table",
      "Date Picker": "@base-ui/react/popover",
      "Dialog": "@base-ui/react/dialog",
      "Drawer": "@base-ui/react/drawer",
      "DropdownMenu*": "@base-ui/react/menu",
      "Input": "@base-ui/react/input",
      "Kbd": "none (a kbd)",
      "KbdGroup": "none (a kbd; composes Kbd)",
      "Navigation / NavButton": "none (an anchor, or a button when it opens a menu)",
      "Navigation / MenuBar": "none (a header holding a nav)",
      "Pagination": "none (a nav; composes Button, Select)",
      "Popover": "@base-ui/react/popover",
      "Radio": "@base-ui/react/radio",
      "Select*": "@base-ui/react/select",
      "Sidebar / SidebarMenuButton": "none (a button, or an anchor when it navigates)",
      "Sidebar / CollapseIcon": "none (an icon)",
      "Sidebar / AddButton": "none (a button)",
      "Sidebar / SidebarMenuSubItem": "none (an li holding an anchor)",
      "Sidebar / SidebarMenuSub": "none (a ul)",
      "Sidebar / SidebarMenuItem": "none (an li)",
      "Sidebar / SidebarGroupLabel": "none (a div)",
      "Sidebar / SidebarGroup": "none (a div)",
      "Sidebar / Popover*": "@base-ui/react/menu",
      "Skeleton": "none (a div with aria-hidden)",
      "Slider*": "@base-ui/react/slider",
      "Switch": "@base-ui/react/switch",
      "Tab *": "@base-ui/react/tabs",
      "Table / Head": "none (a th)",
      "Table / Cell": "none (a td)",
      "Toast": "@base-ui/react/toast",
      "Tooltip": "@base-ui/react/tooltip"
    }
  }
}
